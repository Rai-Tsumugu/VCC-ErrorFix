{
  "name": "vcc-errorfix-mcp",
  "version": "0.1.0",
  "description": "MCP server bridging Claude to Unity Editor via local HTTP API",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "build:bundle": "esbuild src/index.ts --bundle --platform=node --target=node20 --outfile=dist/bundle.cjs --format=cjs",
    "build:exe": "npm run build:bundle && pkg dist/bundle.cjs --targets node20-win-x64,node20-macos-x64,node20-macos-arm64 --out-path bin --compress GZip",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.11.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^4.1.5",
    "@yao-pkg/pkg": "^5.12.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.4.0",
    "vitest": "^4.1.5"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
